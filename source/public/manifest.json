{
  "manifest_version": 3,
  "name": "BossPilot · AI 驱动的 BOSS 求职助手",
  "version": "1.3.0",
  "version_name": "1.3.0 Stability Release",
  "description": "AI 驱动的 BOSS 求职助手，提供智能岗位匹配、AI 沟通优化和求职流程自动化",
  "key": "",
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "alarms",
    "notifications",
    "unlimitedStorage",
    "scripting",
    "debugger",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.zhipin.com/*",
    "https://app.zhipin.com/*",
    "https://api.deepseek.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 BossPilot"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.zhipin.com/*",
        "https://app.zhipin.com/*"
      ],
      "js": [
        "content-v37.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; worker-src 'self'"
  },
  "short_name": "BossPilot",
  "homepage_url": "https://github.com/we-used-to-be/BossPilot",
  "minimum_chrome_version": "116"
}
